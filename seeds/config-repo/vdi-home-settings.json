{
  "model": "opus[1m]",
  "modelPicker": {
    "options": [
      { "model": "claude-sonnet-4-6[1m]", "description": "Sonnet 4.6 · 게이트웨이 · 1M 창" },
      { "model": "claude-opus-4-7[1m]", "description": "Opus 4.7 · 게이트웨이 · 1M 창" },
      { "model": "claude-opus-5[1m]", "description": "Opus 5 · 게이트웨이 · 1M 창" }
    ]
  },
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "PowerShell(& .\\deploy.ps1)",
      "PowerShell(& .\\deploy.ps1 -Yes)",
      "PowerShell(& .\\deploy.ps1 -ShowUnchanged)",
      "PowerShell(& .\\deploy.ps1 -Prune)",
      "PowerShell(& .\\deploy.ps1 -Prune -Yes)"
    ]
  }
}
