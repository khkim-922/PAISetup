#!/bin/sh
# 커밋 메시지 게이트 몸통 — **익명이다. 무엇을 재는지 모른다.**
#
# 진본은 claude-config/.githooks/commit-msg 다. 각 저장소의 것은 deploy.ps1 이
# 뿌린 배포본이다 — 배포본을 고치면 다음 배포에 덮인다.
#
# 재는 것의 진본은 `.githooks/gates.conf` 의 `[commit-msg]` 절이다. 조각은 메시지
# 파일 경로를 $1 로 받는다.
#
# ⚠ **뜻은 여기서 안 잰다.** 무엇을 왜 고쳤나·안 한 것이 담겼나는 의미 판단이라
#   정규식이 후보만 낸다 — 그쪽은 explain-the-essence 스킬이 든다. 여기는 기계가
#   확실히 가를 수 있는 것만 든다.
#
# 알면서 통과시켜야 할 때는:  git commit --no-verify
set -u

# 이 파일이 선 자리 — 까닭은 `pre-commit` 머리의 같은 줄이 든다.
GATES_DIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd)

PROJECT_DIR=$(git rev-parse --show-toplevel) || exit 0
cd "$PROJECT_DIR" || exit 0

MSGFILE="${1:-}"
[ -n "$MSGFILE" ] && [ -f "$MSGFILE" ] || exit 0

CONF="$PROJECT_DIR/.githooks/gates.conf"
# 러너는 **찾는 자가 정한 자리**에서 부른다(GATES_HOME · 0064) — 그 저장소 안 → 붙은 claude-config →
# 홈 씨앗. 형제 저장소는 러너 · 조각 사본을 안 들고 이 몸통(문지기)만 든다. 찾는 자는 이 파일 곁에 선다.
# 제 자리(GATES_CALLER)를 넘긴다 — `core.hooksPath` 가 claude-config 쪽 절대경로면 그 곁이 첫 후보다.
GATES_HOME=""
# shellcheck disable=SC2034 # 바로 아래서 읽히는 찾는 자의 입력이다
GATES_CALLER="$GATES_DIR"
[ -f "$GATES_DIR/claude-config-path.sh" ] && . "$GATES_DIR/claude-config-path.sh"

if [ -z "$GATES_HOME" ]; then
    # 선언도 없으면 게이트를 아직 안 켠 저장소다 — 정당하므로 조용히 지나간다.
    [ -f "$CONF" ] || exit 0
    # ⚠ **선언은 있는데 러너를 어디서도 못 찾으면 알리고 지나간다**(0064). 러너는 claude-config
    #   (또는 홈 씨앗)에 사는데 그것이 이 자리에 안 붙은 것은 이 저장소가 고칠 일이 아니다 —
    #   0061 의 「안 붙은 세션은 알리고 막지 않는다」와 같은 뜻이다. 조용히 지나가지는 않는다:
    #   게이트가 있다고 믿는 채 아무것도 안 재는 것이 제일 나쁘다.
    printf '· 게이트 러너를 못 찾았다 — claude-config 에도 홈 씨앗에도 이 판의 gates-run.sh 가 없다\n' >&2
    printf '  (홈 씨앗이 옛 설치본이면 그 러너는 안 받는다). 이 커밋은 아무것도 안 재고 지나간다.\n' >&2
    printf '  claude-config 를 함께 붙이거나 새 설치본을 깐다.\n' >&2
    exit 0
fi
GATES_DIR="$GATES_HOME"   # 러너가 조각을 찾는 「곁」은 러너가 선 자리다

# ⚠ **선언이 없을 때 말하는 자리는 러너 한 곳이다.** 여기서도 말하면 같은 문장이 두 벌이
#   되고, 한쪽만 고쳐지는 날 둘이 다른 말을 한다. 부재를 침묵으로 두지 않는 것이 핵심이라
#   말하는 것 자체는 반드시 서야 한다 — 그 자리가 `run_gates` 다.

. "$GATES_DIR/gates-run.sh"
run_gates commit-msg "$MSGFILE"
