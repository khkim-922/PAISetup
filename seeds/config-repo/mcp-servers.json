{
  "mcpServers": {
    "github": {
      "type": "http",
      "only": "home,outside",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GH_TOKEN}"
      }
    },
    "tavily-search": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "tavily-mcp"
      ]
    },
    "agy-bridge": {
      "type": "stdio",
      "only": "home,posco",
      "command": "cmd",
      "args": [
        "/c",
        "agy-bridge"
      ],
      "timeout": 660000
    }
  }
}
