{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GH_TOKEN}"
      }
    },
    "tavily-search": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp"
      ]
    }
  }
}
