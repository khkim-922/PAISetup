// markdownlint.global.jsonc — **우리 글 문체가 낳는 오탐.** 어느 저장소에서도 같다.
//
// 진본은 claude-config/.claude/markdownlint.global.jsonc 다. 각 저장소의 것은 deploy.ps1 이
// 뿌린 배포본이다 — 배포본을 고치면 다음 배포에 덮인다.
//
// ── 여기 드는 것과 저장소가 드는 것이 갈린다 ──────────────────────────────────
//   여기      글 쓰는 사람이 같으니 어느 저장소에서든 똑같이 나는 오탐. 문체 판정이다.
//   저장소    그 저장소에만 있는 재료·생성물 자리 — `.markdownlint-cli2.jsonc` 의 `ignores`
//
// 저장소 설정이 이 파일을 가리킨다:
//   { "config": { "extends": "./.claude/markdownlint.global.jsonc", … } }
// ⚠ `extends` 는 **그 설정 파일 기준 상대경로**로 푼다 — 모듈 이름만 적으면 못 찾는다.
//
// ⚠ **여기 든 판정은 손으로 두 번 내리지 않는다.** 형제 저장소 둘이 각자 제 설정에
//   같은 규칙을 같은 값으로 적어 두고 있었고, 그것이 이 파일이 생긴 까닭이다. 끄는
//   근거가 저장소 하나에만 있으면 여기가 아니라 그 저장소 설정에 적는다.
//
// ⚠ **프리셋(relaxed 등)을 안 받는다.** 그 파일은 `markdownlint` 패키지 안에 사는데,
//   전역 설치는 그것을 `markdownlint-cli2/node_modules/` 에 중첩해 두므로(실측
//   2026-09-11) 저장소 기준 상대경로가 안 풀린다. 그리고 **왜 끄는지 모르는 규칙을
//   끌 이유가 없다** — 기본값 위에 우리가 근거를 댄 것만 얹는다.
{
  // MD013 line-length — 줄 길이 80.
  //   한국어 산문은 뜻이 끊기는 자리에서 접는다. 글자수로 접으면 뜻이 갈린다.
  "MD013": false,

  // MD060 table-column-style — 표 파이프 폭 맞추기.
  //   우리 표는 `|---|---|` 조밀 표기로 통일돼 있다. **서식 취향이지 결함이 아니다.**
  //   ⚠ MD056(table-column-count)은 **살린다** — 열 개수가 안 맞는 것은 진짜 결함이고,
  //     표는 어긋난 채로도 멀쩡히 그려져서 눈으로는 안 걸린다.
  "MD060": false,

  // MD036 no-emphasis-as-heading — 굵은 글씨를 제목으로 봄.
  //   우리 문체가 의도적으로 쓴다. 제목을 하나 더 파면 목차가 부풀고 층이 흐려진다.
  "MD036": false,

  // MD022 blanks-around-headings · MD032 blanks-around-lists — 제목·목록 앞뒤 빈 줄.
  //   우리 문체가 안 쓴다. 그리고 지적의 대부분이 결정 기록 안인데, Accepted 된 결정
  //   기록은 본문을 고치지 않으므로(규범 [ADR One-File]) **원리적으로 못 지키는 규칙**이다.
  //   못 지킬 규칙을 켜두면 나머지 진짜가 묻힌다.
  "MD022": false,
  "MD032": false,

  // MD025 single-title — 결정 기록은 머리말(frontmatter)에 title 을 들고 본문에도 제목을
  //   단다. 기본값은 그 머리말을 H1 으로 세어 본문 제목을 **중복으로** 신고한다.
  //   오탐이라 끊되, 규칙 자체는 살린다 — 진짜 H1 둘은 여전히 문다.
  "MD025": { "front_matter_title": "" }
}
