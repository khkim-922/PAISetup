{
  "env": {
    "PYTHONUTF8": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 600,
            "powershell": "git -c 'alias.paisetup-ss=!bash ./.claude/hooks/session-start.sh' paisetup-ss; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": ". \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate-bypass-ask.sh\"",
            "powershell": "exit 0"
          }
        ]
      }
    ]
  }
}
