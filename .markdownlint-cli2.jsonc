// 이 저장소의 markdownlint 설정.
//
// **문체 판정은 여기 없다** — `.claude/markdownlint.global.jsonc` 가 든다. 우리 글이 어느
// 저장소에서든 똑같이 낳는 오탐은 저장소마다 적으면 손사본이 되고, 손으로 두 번 내린
// 판정은 세 번째에서 갈린다.
//
// **여기 드는 것은 이 저장소에만 있는 자리뿐이다 — 어디가 우리가 쓴 글이 아닌가.**
// ⚠ 이 저장소는 **지금 제가 쓴 산문이 한 줄도 없다.** 아래 제외 넷이 담긴 `.md` 를 전부
//   덮는다. 그래도 검사를 켜 두는 까닭은 `encoding` 과 같다 — 비용이 0 이고, 화물이
//   아닌 글이 생기는 날 **저절로** 걸린다.
{
  "config": {
    // ⚠ 경로는 **이 파일 기준**이다. 모듈 이름만 적으면 못 찾는다.
    "extends": "./.claude/markdownlint.global.jsonc"
  },
  "globs": ["**/*.md"],
  "ignores": [
    // ── 아래는 전부 화물이다. 진본은 설정 저장소이고 `dist.manifest.conf` 가 든다.
    //    여기서 고치면 다음 뽑기에 조용히 사라지므로 **재면 안 되는 것**이다.
    // 규범·룰·스킬. ⚠ 스킬의 `references/` 에는 **상류 표준 원문**이 산다 — 상류와 바이트가
    // 같아야 해서 지적이 떠도 손댈 자리가 없다(실제로 여기서 쏟아졌다).
    ".claude/**",
    // 설정 저장소 씨앗 · 게이트웨이 · 검사 묶음
    "seeds/**",
    // 남이 쓴 코드. 허락받아 싣는다 — 우리 문체로 잴 글이 아니다
    "posco/**",
    // `docs/dist-readme.md` 에서 온다
    "README.md",
    // 남의 코드가 들고 온 문서. markdownlint 는 `.gitignore` 를 안 본다
    "node_modules/**"
  ]
}
