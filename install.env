# install.env — 이 폴더의 install.ps1 이 읽는다. **뽑는 자가 만든 것이다.**
#
# 회사 공통값은 채워져 있다. **키만 넣으면 된다** — 설치가 물어보므로 여기 안 적어도
# 되고, 매번 안 묻게 하려면 아래 빈 줄에 제 키를 적는다.
# ⚠ 키를 적었으면 이 파일을 남에게 그대로 넘기지 않는다.

ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-5
CLAUDE_CODE_EFFORT_LEVEL=high
CLAUDE_BYTE_STREAM_IDLE_TIMEOUT_MS=600000
CLAUDE_STREAM_IDLE_TIMEOUT_MS=600000
ANTHROPIC_BASE_URL=http://127.0.0.1:18901/gpgpta01-gpt/
GOOGLE_GEMINI_BASE_URL=http://127.0.0.1:18901/gpgpta01-gpt
ATELIER_SITES=posco

# 게이트웨이 API 키 — 사람마다 다르다. 비우면 설치가 묻는다
ANTHROPIC_AUTH_TOKEN=

#settings-env = yes

#site-probe = aigpt.posco.net:80

#gateway-proxy = posco/pgpt-proxy/opus5_proxy.py

#codex-config = posco/Codex-CLI.setting.toml

#gemini-config = posco/Gemini-CLI.setting.json

#desktop-app = offsite

#corp-ca = posco/corp-ca.pem
