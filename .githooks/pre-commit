#!/bin/sh
# 인코딩 게이트 — **파워셸은 BOM 이 있어야 하고, cmd 는 없어야 한다.**
#
# ⚠ **이 저장소는 배포 대상이 아니다** — 동료에게 가는 zip 그 자체라 개발 파일이 안 들어온다.
#   그래서 설정 저장소가 뿌리는 `.githooks/gates.d/` 한 벌을 못 받는다. 그렇다고 같은 로직을
#   여기 손으로 두면 **진본도 재는 자도 없는 손사본**이 되고, 실제로 그렇게 넷이 갈려 있었다.
#
# 그래서 **씨앗에 실린 조각을 그대로 부른다.** 씨앗은 이 저장소의 짐 중 하나이고 진본에서
# 구워져 오므로, 진본에서 고친 것이 다음 뽑기에 여기에도 온다 — 사본이 아니라 파생물이다.
#
# 알면서 통과시켜야 할 때는:  git commit --no-verify
set -u

PROJECT_DIR=$(git rev-parse --show-toplevel) || exit 0
cd "$PROJECT_DIR" || exit 0

FRAG=seeds/config-repo/.githooks/gates.d/encoding.sh
if [ ! -f "$FRAG" ]; then
    printf '✖ 인코딩 조각이 없다: %s\n' "$FRAG" >&2
    printf '  씨앗이 반쪽만 뽑혔다 — 설정 저장소에서 build-dist.sh 를 다시 돌린다.\n' >&2
    printf '  파워셸의 BOM 은 **남의 PC 에서만** 깨지는 자리라 통과시키지 않는다.\n' >&2
    exit 1
fi
exec sh "$FRAG"
