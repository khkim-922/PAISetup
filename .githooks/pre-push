#!/bin/sh
# 푸시 게이트 몸통 — **익명이다. 무엇을 재는지 모른다.**
#
# 진본은 claude-config/.githooks/pre-push 다. 각 저장소의 것은 deploy.ps1 이
# 뿌린 배포본이다 — 배포본을 고치면 다음 배포에 덮인다.
#
# 재는 것의 진본은 `.githooks/gates.conf` 의 `[pre-push]` 절이다. 절이 없는 저장소는 이 훅이
# 아무것도 안 재고 지나간다(러너가 그렇다고 말한다).
#
# ⚠ **왜 커밋이 아니라 푸시인가.** 이 절에는 저장소 고유 게이트처럼 **한 바퀴가 분 단위인 것**이
#   앉는다. 커밋마다 돌리면 잦은 커밋이 통째로 멈추고 `--no-verify` 가 습관이 된다. 푸시는 원격
#   CI 가 같은 게이트로 빨강을 내기 직전의 마지막 자리다 — 여기서 걸면 빨강을 원격에 올리지 않는다.
# ⚠ **재는 것은 작업 트리다 — 미는 커밋이 아니다.** 커밋 안 한 변경이 남았으면 조각이 그렇다고 말한다.
# ⚠ **git 이 표준입력으로 미는 참조 목록을 준다** — 여기서 한 번 읽고, 조각에는 안 넘긴다(러너가 막는다).
# ⚠ **가지를 올리지 않는 푸시는 안 잰다** — 태그만 · 지우기만 미는 자리다. 잴 코드가 안 움직이는데
#   분 단위를 물면 릴리스 태그 하나 미는 데도 게이트가 돈다.
# ⚠ **`[pre-push]` 절이 없는 저장소는 조용히 지나간다** — 커밋 입구와 달리 이 단계는 켜지 않는 것이
#   기본이라, 푸시마다 「켠 것이 없다」를 말하면 그 줄이 잡음이 되고 진짜 알림이 묻힌다. 무엇이 켜졌나는
#   세션 훅의 「커밋 게이트」 진단 줄이 절마다 센다.
#
# 알면서 통과시켜야 할 때는:  git push --no-verify
set -u

# 이 파일이 선 자리 — 까닭은 `pre-commit` 머리의 같은 줄이 든다.
GATES_DIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd)

PROJECT_DIR=$(git rev-parse --show-toplevel) || exit 0
cd "$PROJECT_DIR" || exit 0

# 미는 참조 — `<로컬 참조> <로컬 해시> <원격 참조> <원격 해시>`. 로컬 해시가 전부 0 이면 지우기다.
_branch=""
while read -r _lref _lsha _rref _rsha; do
    case "$_rref" in refs/heads/*) ;; *) continue ;; esac
    case "$_lsha" in *[!0]*) _branch=1 ;; esac
done
[ -n "$_branch" ] || exit 0

CONF="$PROJECT_DIR/.githooks/gates.conf"
grep -q '^[[:space:]]*\[pre-push\]' "$CONF" 2>/dev/null || exit 0

# 러너는 **찾는 자가 정한 자리**에서 부른다(GATES_HOME · 0064) — 까닭은 `pre-commit` 의 같은 줄이 든다.
GATES_HOME=""
# shellcheck disable=SC2034 # 바로 아래서 읽히는 찾는 자의 입력이다
GATES_CALLER="$GATES_DIR"
[ -f "$GATES_DIR/claude-config-path.sh" ] && . "$GATES_DIR/claude-config-path.sh"

if [ -z "$GATES_HOME" ]; then
    # ⚠ **선언은 있는데 러너를 어디서도 못 찾으면 알리고 지나간다**(0064) — 까닭은 `pre-commit` 이 든다.
    printf '· 게이트 러너를 못 찾았다 — claude-config 에도 홈 씨앗에도 이 판의 gates-run.sh 가 없다\n' >&2
    printf '  (홈 씨앗이 옛 설치본이면 그 러너는 안 받는다). 이 푸시는 아무것도 안 재고 지나간다.\n' >&2
    printf '  claude-config 를 함께 붙이거나 새 설치본을 깐다.\n' >&2
    exit 0
fi
GATES_DIR="$GATES_HOME"   # 러너가 조각을 찾는 「곁」은 러너가 선 자리다

. "$GATES_DIR/gates-run.sh"
run_gates pre-push "$@" </dev/null
